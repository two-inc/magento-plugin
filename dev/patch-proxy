#!/bin/bash
# Configure the Magento container to work behind an FRP reverse proxy.
#
# FRP terminates TLS but forwards X-Forwarded-Proto: http, so Magento would
# otherwise treat proxied requests as insecure and generate http links on an
# https storefront. Apache is told to set HTTPS=on whenever X-Forwarded-Host is
# present, which is how the request arrives through the tunnel.
#
# (The previous image ran PHP's built-in dev server and needed router.php
# patched for the same reason. It also re-applied base URLs from $URL on every
# restart, which needed a custom entrypoint to undo - this image installs once
# and then leaves the configuration alone, so that part is gone.)
#
# Usage: docker exec <container> bash <workdir>/dev/patch-proxy <proxy_url>
# Undo:  docker exec <container> bash <workdir>/dev/patch-proxy --reset

set -e

PROXY_URL="$1"
CONF=/etc/apache2/conf-available/frp-proxy.conf
# Set by compose; the storefront URL when no proxy is in play.
LOCAL_URL=${URL:-http://localhost/}

# Point Magento at a base URL. $2 is 1 to serve it over https, 0 for plain http.
set_base_urls() {
    local url="${1%/}/" secure="$2" setting
    for setting in \
        "web/unsecure/base_url ${url}" \
        "web/secure/base_url ${url}" \
        "web/unsecure/base_link_url ${url}" \
        "web/secure/base_link_url ${url}" \
        "web/secure/use_in_frontend ${secure}" \
        "web/secure/use_in_adminhtml ${secure}"
    do
        # shellcheck disable=SC2086 # deliberate split into config path and value
        php bin/magento config:set $setting 2>&1 | grep -v Xdebug || true
    done
    php bin/magento cache:flush 2>&1 | grep -v Xdebug > /dev/null || true
}

if [ "$PROXY_URL" = "--reset" ]; then
    a2disconf frp-proxy >/dev/null 2>&1 || true
    rm -f "$CONF"
    apache2ctl graceful 2>/dev/null || true
    # The base URLs must go back to the local one here. The previous image
    # reapplied $URL on every restart, so a stale proxy URL corrected itself;
    # this one installs once and then leaves configuration alone, so without
    # this the storefront keeps linking to a tunnel that is no longer up.
    set_base_urls "$LOCAL_URL" 0
    echo "Proxy reset: ${LOCAL_URL}"
    exit 0
fi

if [ -z "$PROXY_URL" ]; then
    echo "Usage: patch-proxy <proxy_url>"
    echo "       patch-proxy --reset"
    exit 1
fi

cat > "$CONF" <<'CONFEOF'
# Written by dev/patch-proxy. FRP terminates TLS upstream and forwards
# X-Forwarded-Proto: http, so presence of X-Forwarded-Host is what marks a
# request as having arrived over the tunnel.
SetEnvIf X-Forwarded-Host ".+" HTTPS=on
CONFEOF
a2enconf frp-proxy >/dev/null 2>&1 || true
apache2ctl graceful 2>/dev/null || true

set_base_urls "$PROXY_URL" 1
echo "Proxy configured: ${PROXY_URL}"
