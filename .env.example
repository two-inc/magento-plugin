# Local dev environment — copy to .env and adjust. Read via Makefile
# `-include .env` (base/shared values; .env.local, also gitignored, layers
# on top for personal overrides — see .env.local.example).

# Merchant API key for the sandbox environment. Without this, `make install`
# falls back to TWO_API_KEY=dummy-dev-key and payment calls to the sandbox
# API will fail.
TWO_API_KEY=dummy-dev-key
