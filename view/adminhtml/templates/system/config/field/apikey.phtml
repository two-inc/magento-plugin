use Two\Gateway\Block\Adminhtml\System\Config\Field\ApiKeyCheck;

/**
 * @var ApiKeyCheck $block
 */
$status = $block->getApiKeyStatus();
?>
<div class="two-api-key-verify"
     data-verify-url="<?= $block->escapeHtmlAttr($block->getVerifyUrl()); ?>"
     data-field-id="<?= $block->escapeHtmlAttr($block->getApiKeyFieldId()); ?>"
     data-scope="<?= $block->escapeHtmlAttr($block->getScope()); ?>"
     data-scope-id="<?= (int)$block->getScopeId(); ?>">
    <span class="two-api-key-verify__input-wrap">
        <?= /* @noEscape */ $block->getInputHtml(); ?>
        <span class="two-api-key-verify__icon api-key-status-icon <?= $block->escapeHtmlAttr('api-key-' . $status['status']); ?>"></span>
    </span>
    <div class="two-api-key-verify__status">
        <span class="two-api-key-verify__message"><?= $block->escapeHtml($status['message']); ?></span>
        <?php
        // No raw upstream response body is rendered here. It used to be
        // echoed alongside the message, which put an API error payload in
        // front of a merchant while telling them, wrongly, that their key
        // was invalid. getApiKeyStatus() now carries a category-specific
        // message (and, where an HTTP exchange completed, its status code)
        // which is the whole of what an admin can act on.
        ?>
        <?php
        // Always rendered (hidden when there is no merchant) so the live check
        // can fill in the merchant a candidate key resolves to before save.
        $merchantId = (string)($status['merchant_id'] ?? '');
        $shortName = $merchantId !== '' ? (string)($status['merchant_short_name'] ?? '') : '';
        ?>
        <div class="two-api-key-verify__merchant"
             style="margin-top: 8px; color: #666; font-size: 13px;"<?= $merchantId === '' ? ' hidden' : ''; ?>>
            <strong><?= $block->escapeHtml(__('Merchant ID:')); ?></strong>
            <span class="two-api-key-verify__merchant-id"><?= $block->escapeHtml($merchantId); ?></span><span
                class="two-api-key-verify__merchant-short-name"><?php if ($shortName !== ''): ?>
                &middot; <?= $block->escapeHtml($shortName); ?><?php endif; ?></span>
        </div>
    </div>
</div>
