use Two\Gateway\Block\Adminhtml\System\Config\Button\RefreshMerchantRecord;

/**
 * @var RefreshMerchantRecord $block
 */
?>
<div class="two-refresh-merchant-record" id="two-refresh-merchant-record"
     data-refresh-url="<?= $block->escapeHtmlAttr($block->getRefreshUrl()); ?>"
     data-scope="<?= $block->escapeHtmlAttr($block->getScope()); ?>"
     data-scope-id="<?= (int)$block->getScopeId(); ?>">
    <button type="button" class="action-default two-refresh-merchant-record__button">
        <span><?= $block->escapeHtml(__('Refresh merchant profile')); ?></span>
    </button>
    <?php /* TWO-26153: a refresh reloads the page here, stamped, so this confirms it once. */ ?>
    <?php if ($block->isRefreshed()): ?>
        <div class="two-refresh-merchant-record__status success"><?= $block->escapeHtml(__('Merchant profile refreshed.')); ?></div>
    <?php else: ?>
        <div class="two-refresh-merchant-record__status"></div>
    <?php endif; ?>
</div>
